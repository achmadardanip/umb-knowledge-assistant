DATABASE_URL=postgresql+psycopg://postgres:<SUPABASE_DB_PASSWORD>@db.<SUPABASE_PROJECT_REF>.supabase.co:5432/postgres
# Optional for GitHub Actions if direct Supabase database host resolves to IPv6-only.
# Store this as GitHub repository secret SUPABASE_POOLER_DATABASE_URL.
SUPABASE_POOLER_DATABASE_URL=postgresql+psycopg://postgres.<SUPABASE_PROJECT_REF>:<SUPABASE_DB_PASSWORD>@aws-0-<SUPABASE_REGION>.pooler.supabase.com:6543/postgres
LOCAL_SQLITE_FALLBACK_ENABLED=true
LOCAL_SQLITE_PATH=local-dev.db

AI_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-20b:free

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

DISCOVERY_ENABLED=true
DISCOVERY_DOMAIN=mercubuana.ac.id
DISCOVERY_MAX_DEPTH=5
DISCOVERY_MAX_URLS=100000
DISCOVERY_RATE_LIMIT=1
DISCOVERY_TIMEOUT_SECONDS=20

ENABLE_SUBLIST3R=true
ENABLE_KATANA=true
ENABLE_HAKRAWLER=false
ENABLE_GAU=true
ENABLE_WAYBACKURLS=true
ENABLE_FFUF=false
ENABLE_DIRSEARCH=false

FFUF_RATE_LIMIT=10
DIRSEARCH_RATE_LIMIT=10
SAFE_WORDLIST_PATH=data/wordlists/safe_public_paths.txt

CRAWLER_MAX_PAGES=50000
CRAWLER_MAX_DEPTH=5
CRAWLER_RATE_LIMIT=1
CRAWLER_TIMEOUT_SECONDS=10
INDEX_TARGET_SOURCES=50000
ALLOWED_DOMAIN=mercubuana.ac.id
CHUNK_SIZE=900
CHUNK_OVERLAP=120
RAG_TOP_K_DEFAULT=5
RAG_TOP_K_MAX=8
CHAT_HISTORY_MAX_MESSAGES=5
RAG_ANSWER_CACHE_ENABLED=true
RAG_ANSWER_CACHE_TTL_SECONDS=86400
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=2
LLM_FALLBACK_EXTRACTIVE=true
LLM_FALLBACK_PROVIDERS=openai

WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_TOP_K=5
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_STRICT_DOMAIN=mercubuana.ac.id
WEB_SEARCH_CACHE_ANSWERS=false

AGENT_MODE_ENABLED=true
AGENT_MAX_TOOL_ITERATIONS=3
LLM_TITLE_GENERATION_ENABLED=false

MULTIMODAL_INGESTION_ENABLED=true

MAX_PDF_SIZE_MB=30
MAX_DOC_SIZE_MB=20
MAX_PPT_SIZE_MB=50
MAX_SPREADSHEET_SIZE_MB=20
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=50
MAX_VIDEO_SIZE_MB=200

ENABLE_OCR=false
OCR_PROVIDER=tesseract

ENABLE_ASR=false
ASR_PROVIDER=faster-whisper
ASR_MODEL_SIZE=base

ENABLE_VIDEO_DOWNLOAD=false
ENABLE_YTDLP_METADATA=true
ENABLE_TABLE_EXTRACTION=true

MULTIMODAL_MAX_FILES_PER_RUN=50000
MULTIMODAL_MIN_EXTRACTION_CHARS=100
LOW_CONFIDENCE_THRESHOLD=0.5

MEMORY_ENABLED=true
MEMORY_SUMMARY_INTERVAL=6
MEMORY_MAX_ITEMS=20

FRONTEND_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
