# ── Database: PostgreSQL + pgvector is the only production DB (no Supabase needed) ──
# Local-first default. The app boots with just these — no SUPABASE_* variable required.
LOCAL_POSTGRES_MODE=true
LOCAL_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/umb
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/umb
VECTOR_DB=pgvector
LOCAL_SQLITE_FALLBACK_ENABLED=false
LOCAL_SQLITE_PATH=local-dev.db
# OPTIONAL legacy: only set if migrating data FROM a hosted Postgres (e.g. Supabase) via
# `python -m app.db.supabase_to_local`. Not used at runtime when LOCAL_POSTGRES_MODE=true.
# SUPABASE_POOLER_DATABASE_URL=

ANSWER_PROVIDER=local_ollama
AI_PROVIDER=local_ollama
ANSWER_ENABLE_FALLBACK=true
ANSWER_FALLBACK_PROVIDER=puter
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_TEMPERATURE=0.1
LOCAL_LLM_MAX_TOKENS=2048
LOCAL_LLM_TIMEOUT_SECONDS=180
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model
LMSTUDIO_API_KEY=lm-studio

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-20b:free

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure AI Foundry (Phase 30) — OpenAI-compatible chat completions.
# Select with ANSWER_PROVIDER=azure_foundry (or pick "Azure AI Foundry" in the UI).
AZURE_FOUNDRY_ENDPOINT=https://ardan.services.ai.azure.com/
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=
AZURE_FOUNDRY_API_VERSION=2024-10-21

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

HERMES_ENABLED=false
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

EMBEDDING_PROVIDER=local_e5
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROFILE=local-e5-small-v1
EMBEDDING_VERSION=1
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
LOCAL_EMBEDDING_DIMENSION=384
LOCAL_EMBEDDING_BATCH_SIZE=32
LOCAL_EMBEDDING_DEVICE=auto

DISCOVERY_ENABLED=true
DISCOVERY_DOMAIN=mercubuana.ac.id
DISCOVERY_MAX_DEPTH=5
DISCOVERY_MAX_URLS=100000
DISCOVERY_RATE_LIMIT=1
DISCOVERY_TIMEOUT_SECONDS=20

ENABLE_SUBLIST3R=true
ENABLE_KATANA=true
ENABLE_HAKRAWLER=false
ENABLE_GAU=true
ENABLE_WAYBACKURLS=true
ENABLE_FFUF=false
ENABLE_DIRSEARCH=false

FFUF_RATE_LIMIT=10
DIRSEARCH_RATE_LIMIT=10
SAFE_WORDLIST_PATH=data/wordlists/safe_public_paths.txt

CRAWLER_MAX_PAGES=50000
CRAWLER_MAX_DEPTH=5
CRAWLER_RATE_LIMIT=1
CRAWLER_TIMEOUT_SECONDS=10
INDEX_TARGET_SOURCES=50000
ALLOWED_DOMAIN=mercubuana.ac.id
CHUNK_SIZE=900
CHUNK_OVERLAP=120
RAG_TOP_K_DEFAULT=5
RAG_TOP_K_MAX=8
CHAT_HISTORY_MAX_MESSAGES=5
RAG_ANSWER_CACHE_ENABLED=true
RAG_ANSWER_CACHE_TTL_SECONDS=86400
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=2
# Disabled: an unverified answer becomes a clean "contact admin" fallback, not a snippet dump.
LLM_FALLBACK_EXTRACTIVE=false
LLM_FALLBACK_PROVIDERS=gemini,openai

# Corroboration-Gated Claim Verification (CGCV). Off until calibrated on the eval set.
CGCV_ENABLED=false
CGCV_ENTAILMENT_THRESHOLD=0.5
CGCV_MIN_SUPPORTED_CLAIMS=1

# Safety floor (OWASP LLM10 / LLM01).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_QUESTION_CHARS=4000

# Trust-Aware Hybrid Fusion + dense semantic retrieval.
TAHF_AUTHORITY_WEIGHT=1.0
TAHF_FRESHNESS_WEIGHT=0.5
# Requires add_chunk_embeddings.sql and a completed active-profile backfill.
DENSE_RETRIEVAL_ENABLED=true
# Qwen3-Reranker-0.6B (local_qwen3) is the default; local_bge (BAAI/bge-reranker-v2-m3) also supported.
RERANKER_ENABLED=true
RERANKER_PROVIDER=local_qwen3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_CANDIDATE_K=20
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=512
RERANKER_MODEL_WEIGHT=0.8
RERANKER_PREWARM_ENABLED=true

# Volatility-Aware Just-in-Time live re-verification (needs live web search).
VA_JIT_ENABLED=false
VA_JIT_BUDGET=2
VA_JIT_VOLATILITY_THRESHOLD=0.7
VA_JIT_FRESHNESS_THRESHOLD=0.5

WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_TOP_K=5
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_STRICT_DOMAIN=mercubuana.ac.id
WEB_SEARCH_CACHE_ANSWERS=false
WEB_KB_INGEST_ENABLED=true

FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=http://localhost:3002
FIRECRAWL_SELF_HOSTED=true
FIRECRAWL_DEFAULT_LIMIT=500
FIRECRAWL_TIMEOUT_SECONDS=60
FIRECRAWL_MAX_RETRIES=3
FIRECRAWL_RETRY_BACKOFF_SECONDS=2
FIRECRAWL_DELAY_SECONDS=1
FIRECRAWL_MAX_CONCURRENCY=2
FIRECRAWL_MAX_RELATED_LINKS_PER_PAGE=500
FIRECRAWL_POLL_INTERVAL_SECONDS=10
FIRECRAWL_MAX_WAIT_SECONDS=1800
FIRECRAWL_ZERO_DATA_RETENTION=false

AGENT_MODE_ENABLED=true
AGENT_MAX_TOOL_ITERATIONS=3
LLM_TITLE_GENERATION_ENABLED=false

MULTIMODAL_INGESTION_ENABLED=true

MAX_PDF_SIZE_MB=30
MAX_DOC_SIZE_MB=20
MAX_PPT_SIZE_MB=50
MAX_SPREADSHEET_SIZE_MB=20
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=50
MAX_VIDEO_SIZE_MB=200

ENABLE_OCR=false
OCR_LANGUAGES=ind+eng
OCR_PROVIDER=tesseract
MULTIMODAL_EMBEDDING_PROVIDER=disabled
JINA_EMBEDDING_MODEL=jinaai/jina-embeddings-v4
VISION_PROVIDER=disabled
QWEN_VL_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

ENABLE_ASR=false
ASR_PROVIDER=faster-whisper
ASR_MODEL_SIZE=base

ENABLE_VIDEO_DOWNLOAD=false
ENABLE_YTDLP_METADATA=true
ENABLE_TABLE_EXTRACTION=true

MULTIMODAL_MAX_FILES_PER_RUN=50000
MULTIMODAL_MIN_EXTRACTION_CHARS=100
LOW_CONFIDENCE_THRESHOLD=0.5

MEMORY_ENABLED=true
MEMORY_SUMMARY_INTERVAL=6
MEMORY_MAX_ITEMS=20

FRONTEND_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
